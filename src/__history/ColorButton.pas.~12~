unit ColorButton;

interface

uses
  System.Classes,
  System.SysUtils,
  System.Types,
  Vcl.Controls,
  Vcl.Graphics,
  Vcl.Buttons,
  Winapi.Windows,
  Winapi.Messages;

type
  TCustomColorButton = class(TCustomControl)
  private
    FColorEnabled: TColor;
    FColorDisabled: TColor;
    FColorHover: TColor;
    FCornerRadius: Integer;
    FPicture: TPicture;
    FIsDown: Boolean;
    FMouseInControl: Boolean;
    FLayout: TButtonLayout;
    FSpacing: Integer;
    FFlat: Boolean;

    procedure SetColorEnabled(const Value: TColor);
    procedure SetColorDisabled(const Value: TColor);
    procedure SetColorHover(const Value: TColor);
    procedure SetCornerRadius(const Value: Integer);
    procedure SetPicture(const Value: TPicture);
    procedure SetLayout(const Value: TButtonLayout);
    procedure SetSpacing(const Value: Integer);
    procedure SetFlat(const Value: Boolean);

    procedure PictureChanged(Sender: TObject);
    procedure UpdateControlRegion;

    procedure WMEraseBkgnd(var Message: TWMEraseBkgnd); message WM_ERASEBKGND;
    procedure CMMouseEnter(var Message: TMessage); message CM_MOUSEENTER;
    procedure CMMouseLeave(var Message: TMessage); message CM_MOUSELEAVE;
    procedure CMEnabledChanged(var Message: TMessage); message CM_ENABLEDCHANGED;

    procedure WMSetFocus(var Message: TWMSetFocus); message WM_SETFOCUS;
    procedure WMKillFocus(var Message: TWMKillFocus); message WM_KILLFOCUS;
  protected
    procedure Paint; override;
    procedure Resize; override;
    procedure MouseDown(Button: TMouseButton; Shift: TShiftState; X, Y: Integer); override;
    procedure MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer); override;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure KeyUp(var Key: Word; Shift: TShiftState); override;
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
  published
    property Align;
    property Anchors;
    property Caption;
    property Color;
    property Enabled;
    property Font;
    property ParentFont;
    property ParentShowHint;
    property ShowHint;
    property TabOrder;
    property TabStop default True;
    property Visible;
    property OnClick;
    property OnEnter;
    property OnExit;
    property OnKeyDown;
    property OnKeyPress;
    property OnKeyUp;
    property OnMouseDown;
    property OnMouseEnter;
    property OnMouseLeave;
    property OnMouseMove;
    property OnMouseUp;

    property ColorEnabled: TColor read FColorEnabled write SetColorEnabled default clBtnFace;
    property ColorDisabled: TColor read FColorDisabled write SetColorDisabled default clBtnFace;
    property ColorHover: TColor read FColorHover write SetColorHover default clHighlight;
    property CornerRadius: Integer read FCornerRadius write SetCornerRadius default 8;
    property Flat: Boolean read FFlat write SetFlat default False;
    property Layout: TButtonLayout read FLayout write SetLayout default blGlyphLeft;
    property Spacing: Integer read FSpacing write SetSpacing default 4;
    property Picture: TPicture read FPicture write SetPicture;
  end;

procedure Register;

implementation

uses
  Vcl.ExtCtrls,
  Vcl.Imaging.pngimage;

type
  TWinControlAccess = class(TWinControl);

procedure Register;
begin
  RegisterComponents('Samples', [TCustomColorButton]);
end;

{ TCustomColorButton }

constructor TCustomColorButton.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  DoubleBuffered := True;
  // Modificado: Removemos csOpaque para evitar sobrescrita quadrada do Windows
  ControlStyle := [csSetCaption, csDoubleClicks, csReplicatable];
  Width := 75;
  Height := 25;
  TabStop := True;

  FColorEnabled := clBtnFace;
  FColorDisabled := clBtnFace;
  FColorHover := clHighlight;
  FCornerRadius := 8;
  FFlat := False;
  FLayout := blGlyphLeft;
  FSpacing := 4;
  Color := clBtnFace;

  FPicture := TPicture.Create;
  FPicture.OnChange := PictureChanged;
end;

destructor TCustomColorButton.Destroy;
begin
  FPicture.Free;
  inherited Destroy;
end;

procedure TCustomColorButton.UpdateControlRegion;
var
  Rgn: HRGN;
begin
  // Recorta a janela do controle no próprio Windows de acordo com o CornerRadius
  if HandleAllocated then
  begin
    if FCornerRadius > 0 then
    begin
      Rgn := CreateRoundRectRgn(0, 0, Width + 1, Height + 1, FCornerRadius, FCornerRadius);
      SetWindowRgn(Handle, Rgn, True);
    end
    else
      SetWindowRgn(Handle, 0, True);
  end;
end;

procedure TCustomColorButton.Resize;
begin
  inherited;
  UpdateControlRegion;
end;

procedure TCustomColorButton.WMEraseBkgnd(var Message: TWMEraseBkgnd);
begin
  Message.Result := 1;
end;

procedure TCustomColorButton.PictureChanged(Sender: TObject);
begin
  Invalidate;
end;

procedure TCustomColorButton.SetPicture(const Value: TPicture);
begin
  FPicture.Assign(Value);
end;

procedure TCustomColorButton.SetColorEnabled(const Value: TColor);
begin
  if FColorEnabled <> Value then
  begin
    FColorEnabled := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetColorDisabled(const Value: TColor);
begin
  if FColorDisabled <> Value then
  begin
    FColorDisabled := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetColorHover(const Value: TColor);
begin
  if FColorHover <> Value then
  begin
    FColorHover := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetCornerRadius(const Value: Integer);
begin
  if (FCornerRadius <> Value) and (Value >= 0) then
  begin
    FCornerRadius := Value;
    UpdateControlRegion;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetFlat(const Value: Boolean);
begin
  if FFlat <> Value then
  begin
    FFlat := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetLayout(const Value: TButtonLayout);
begin
  if FLayout <> Value then
  begin
    FLayout := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.SetSpacing(const Value: Integer);
begin
  if FSpacing <> Value then
  begin
    FSpacing := Value;
    Invalidate;
  end;
end;

procedure TCustomColorButton.CMMouseEnter(var Message: TMessage);
begin
  inherited;
  FMouseInControl := True;
  Invalidate;
end;

procedure TCustomColorButton.CMMouseLeave(var Message: TMessage);
begin
  inherited;
  FMouseInControl := False;
  Invalidate;
end;

procedure TCustomColorButton.CMEnabledChanged(var Message: TMessage);
begin
  inherited;
  Invalidate;
end;

procedure TCustomColorButton.WMSetFocus(var Message: TWMSetFocus);
begin
  inherited;
  Invalidate;
end;

procedure TCustomColorButton.WMKillFocus(var Message: TWMKillFocus);
begin
  inherited;
  Invalidate;
end;

procedure TCustomColorButton.MouseDown(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  inherited;
  if (Button = mbLeft) and Enabled then
  begin
    if CanFocus then
      SetFocus;
    FIsDown := True;
    Invalidate;
  end;
end;

procedure TCustomColorButton.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  inherited;
  if FIsDown then
  begin
    FIsDown := False;
    Invalidate;
  end;
end;

procedure TCustomColorButton.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_SPACE) or (Key = VK_RETURN) then
  begin
    FIsDown := True;
    Invalidate;
  end;
end;

procedure TCustomColorButton.KeyUp(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if FIsDown then
  begin
    FIsDown := False;
    Invalidate;
    if (Key = VK_SPACE) or (Key = VK_RETURN) then
      Click;
  end;
end;

procedure TCustomColorButton.Paint;
var
  PaintRect, TextRect, FocusRect: TRect;
  CurrentColor, BorderColor: TColor;
  Flags: Cardinal;
  ImgPos: TPoint;
  ImgWidth, ImgHeight: Integer;
  HasImage, HasText: Boolean;
  TotalWidth, TotalHeight: Integer;
  TextW, TextH: Integer;
  DrawGraphic: TGraphic;
  DrawBorder: Boolean;
  ParentColor: TColor;
begin
  // Atualiza a região fisicamente caso ainda não tenha sido criada
  UpdateControlRegion;

  PaintRect := ClientRect;
  Flags := DT_CENTER or DT_VCENTER or DT_SINGLELINE;

  if Parent <> nil then
    ParentColor := TWinControlAccess(Parent).Color
  else
    ParentColor := clBtnFace;

  Canvas.Brush.Color := ParentColor;
  Canvas.Brush.Style := bsSolid;
  Canvas.FillRect(PaintRect);

  // 1. Determina as cores conforme o estado e propriedade Flat
  if not Enabled then
  begin
    CurrentColor := FColorDisabled;
    BorderColor := clBtnShadow;
    DrawBorder := not FFlat;
  end
  else if FMouseInControl then
  begin
    CurrentColor := FColorHover;
    BorderColor := clHighlight;
    DrawBorder := True;
  end
  else
  begin
    if FColorEnabled <> clBtnFace then
      CurrentColor := FColorEnabled
    else
      CurrentColor := Color;

    BorderColor := clBtnShadow;
    DrawBorder := not FFlat;
  end;

  // 2. Preenche o fundo e desenha a borda
  Canvas.Brush.Color := CurrentColor;
  Canvas.Brush.Style := bsSolid;

  if (FCornerRadius > 0) then
  begin
    if DrawBorder then
      Canvas.Pen.Color := BorderColor
    else
      Canvas.Pen.Color := CurrentColor;

    Canvas.Pen.Style := psSolid;
    Canvas.RoundRect(0, 0, Width, Height, FCornerRadius, FCornerRadius);
  end
  else
  begin
    if DrawBorder then
    begin
      Canvas.Pen.Color := BorderColor;
      Canvas.Pen.Style := psSolid;
      Canvas.Rectangle(0, 0, Width, Height);
    end
    else
    begin
      Canvas.Pen.Style := psClear;
      Canvas.FillRect(PaintRect);
    end;
  end;

  // 3. Indicador suave de foco
  if Focused and Enabled then
  begin
    FocusRect := ClientRect;
    InflateRect(FocusRect, -2, -2);
    Canvas.Pen.Color := clGray;
    Canvas.Pen.Style := psDot;
    Canvas.Brush.Style := bsClear;

    if FCornerRadius > 0 then
      Canvas.RoundRect(FocusRect.Left, FocusRect.Top, FocusRect.Right, FocusRect.Bottom, FCornerRadius - 2, FCornerRadius - 2)
    else
      Canvas.Rectangle(FocusRect);
  end;

  PaintRect := ClientRect;

  if FIsDown then
    OffsetRect(PaintRect, 1, 1);

  // 4. Seleção da imagem
  DrawGraphic := nil;
  if (FPicture <> nil) and (FPicture.Graphic <> nil) and not FPicture.Graphic.Empty then
    DrawGraphic := FPicture.Graphic;

  HasImage := DrawGraphic <> nil;
  HasText := Caption <> '';

  ImgWidth := 0;
  ImgHeight := 0;

  if HasImage then
  begin
    ImgWidth := DrawGraphic.Width;
    ImgHeight := DrawGraphic.Height;
  end;

  Canvas.Font := Self.Font;
  TextW := Canvas.TextWidth(Caption);
  TextH := Canvas.TextHeight(Caption);

  // 5. Posicionamento de imagem e texto
  if HasImage then
  begin
    if HasText then
    begin
      case FLayout of
        blGlyphLeft:
        begin
          TotalWidth := ImgWidth + FSpacing + TextW;
          ImgPos.X := (Width - TotalWidth) div 2;
          ImgPos.Y := (Height - ImgHeight) div 2;

          TextRect := PaintRect;
          TextRect.Left := ImgPos.X + ImgWidth + FSpacing;
          Flags := DT_LEFT or DT_VCENTER or DT_SINGLELINE;
        end;

        blGlyphRight:
        begin
          TotalWidth := ImgWidth + FSpacing + TextW;
          ImgPos.X := (Width - TotalWidth) div 2 + TextW + FSpacing;
          ImgPos.Y := (Height - ImgHeight) div 2;

          TextRect := PaintRect;
          TextRect.Right := ImgPos.X - FSpacing;
          Flags := DT_RIGHT or DT_VCENTER or DT_SINGLELINE;
        end;

        blGlyphTop:
        begin
          TotalHeight := ImgHeight + FSpacing + TextH;
          ImgPos.X := (Width - ImgWidth) div 2;
          ImgPos.Y := (Height - TotalHeight) div 2;

          TextRect := PaintRect;
          TextRect.Top := ImgPos.Y + ImgHeight + FSpacing;
          Flags := DT_CENTER or DT_TOP or DT_SINGLELINE;
        end;

        blGlyphBottom:
        begin
          TotalHeight := ImgHeight + FSpacing + TextH;
          ImgPos.Y := (Height - TotalHeight) div 2 + TextH + FSpacing;
          ImgPos.X := (Width - ImgWidth) div 2;

          TextRect := PaintRect;
          TextRect.Bottom := ImgPos.Y - FSpacing;
          Flags := DT_CENTER or DT_BOTTOM or DT_SINGLELINE;
        end;
      end;
    end
    else
    begin
      ImgPos.X := (Width - ImgWidth) div 2;
      ImgPos.Y := (Height - ImgHeight) div 2;
    end;

    if FIsDown then
    begin
      Inc(ImgPos.X);
      Inc(ImgPos.Y);
    end;

    Canvas.Draw(ImgPos.X, ImgPos.Y, DrawGraphic);
  end;

  // 6. Desenho do texto
  if HasText then
  begin
    if not Enabled then
      Canvas.Font.Color := clGrayText
    else
      Canvas.Font.Color := Self.Font.Color;

    Canvas.Brush.Style := bsClear;

    if not HasImage then
    begin
      TextRect := PaintRect;
      Flags := DT_CENTER or DT_VCENTER or DT_SINGLELINE;
    end;

    DrawText(Canvas.Handle, PChar(Caption), -1, TextRect, Flags);
  end;
end;

end.
